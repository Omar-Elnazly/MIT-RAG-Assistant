# ------------------------------------------------------------------
# SmartUniversityAssistant backend configuration
#
# Copy this file to `.env` and adjust paths/hosts for your machine.
# Values below match notebooks/rag_pipeline.ipynb (the source of truth
# for the RAG implementation) unless noted otherwise.
# ------------------------------------------------------------------

# --- Vector store (Chroma) ---
# Path to the persisted Chroma store. Relative path is resolved against
# the backend/ directory. Point this at wherever you copied the
# vector_store folder produced by the notebook.
CHROMA_PERSIST_DIR=./data/vector_store

# Exact Chroma collection name created in the notebook
# (chroma_client.create_collection(name=COLLECTION_NAME)). Must match
# exactly or the backend won't find the persisted collection.
CHROMA_COLLECTION_NAME=rag_assistant_chunks

# --- Embeddings ---
# Must match the model used to build the persisted embeddings
# (EMBEDDING_MODEL_NAME in the notebook). Changing this without
# re-embedding the corpus will break retrieval.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# --- Retrieval ---
# Number of chunks retrieved per query (DEFAULT_K in the notebook).
RETRIEVAL_TOP_K=5

# --- Ollama generation ---
# Ollama server host (OLLAMA_HOST in the notebook).
OLLAMA_HOST=http://127.0.0.1:11434

# Ollama model tag (OLLAMA_MODEL in the notebook).
OLLAMA_MODEL=llama3.2:3b

# Generation options passed to ollama_client.chat(..., options={...})
# in generate_answer() in the notebook.
OLLAMA_TEMPERATURE=0.0
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=400

# --- API / CORS ---
# Comma-separated list of origins allowed to call this API.
# Not part of the notebook - set this to your frontend's dev/prod URL(s).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
